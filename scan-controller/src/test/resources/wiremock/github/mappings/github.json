{
  "mappings": [
    {
      "name": "the App is installed on every acme repo",
      "priority": 5,
      "request": {
        "method": "GET", "urlPathPattern": "/repos/acme/[^/]+/installation",
        "headers": {"Authorization": {"matches": "Bearer [\\w-]+\\.[\\w-]+\\.[\\w-]+"}}
      },
      "response": {
        "status": 200, "headers": {"Content-Type": "application/json"},
        "jsonBody": {"id": 4242, "account": {"login": "acme"}, "app_id": 12345}
      }
    },
    {
      "name": "acme/not-installed is not visible to the App",
      "priority": 1,
      "request": {"method": "GET", "urlPath": "/repos/acme/not-installed/installation"},
      "response": {
        "status": 404, "headers": {"Content-Type": "application/json"},
        "jsonBody": {"message": "Not Found", "status": "404"}
      }
    },
    {
      "name": "acme/github-down: GitHub has an outage",
      "priority": 1,
      "request": {"method": "GET", "urlPath": "/repos/acme/github-down/installation"},
      "response": {"status": 503, "jsonBody": {"message": "Service Unavailable"}}
    },
    {
      "name": "installation token, contents read",
      "request": {
        "method": "POST", "urlPath": "/app/installations/4242/access_tokens",
        "headers": {"Authorization": {"matches": "Bearer [\\w-]+\\.[\\w-]+\\.[\\w-]+"}},
        "bodyPatterns": [{"equalToJson": {"permissions": {"contents": "read"}}}]
      },
      "response": {
        "status": 201, "headers": {"Content-Type": "application/json"},
        "jsonBody": {"token": "ghs_mock_installation_token", "expires_at": "2099-01-01T00:00:00Z",
                     "permissions": {"contents": "read"}, "repository_selection": "all"}
      }
    },
    {
      "name": "revoking an installation token",
      "request": {
        "method": "DELETE", "urlPath": "/installation/token",
        "headers": {"Authorization": {"matches": "Bearer ghs_\\w+"}}
      },
      "response": {"status": 204}
    },
    {
      "name": "every commit exists",
      "priority": 5,
      "request": {
        "method": "GET", "urlPathPattern": "/repos/acme/[^/]+/commits/[0-9a-f]{40}",
        "headers": {"Authorization": {"equalTo": "Bearer ghs_mock_installation_token"}}
      },
      "response": {
        "status": 200, "headers": {"Content-Type": "application/json"},
        "jsonBody": {"commit": {"message": "mock commit"}}
      }
    },
    {
      "name": "except the all-zero sha",
      "priority": 1,
      "request": {"method": "GET", "urlPathPattern": "/repos/acme/[^/]+/commits/0{40}"},
      "response": {
        "status": 422, "headers": {"Content-Type": "application/json"},
        "jsonBody": {"message": "No commit found for SHA: 0000000000000000000000000000000000000000"}
      }
    }
  ]
}
