{
  "mappings": [
    {
      "name": "acme/payments@main exists and names its repository (D-037)",
      "priority": 1,
      "request": {
        "method": "GET",
        "urlPath": "/api/v1/project/lookup",
        "queryParameters": {
          "name": {
            "equalTo": "acme/payments"
          },
          "version": {
            "equalTo": "main"
          }
        },
        "headers": {
          "X-Api-Key": {
            "matches": ".+"
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "uuid": "0b6f0000-0000-4000-8000-000000000001",
          "name": "acme/payments",
          "version": "main",
          "active": true,
          "externalReferences": [
            {
              "type": "vcs",
              "url": "scm:git:git@github.com:Acme/Payments.git"
            },
            {
              "type": "website",
              "url": "https://payments.acme.example"
            }
          ]
        }
      }
    },
    {
      "name": "acme/empty@main exists and has no findings",
      "priority": 1,
      "request": {
        "method": "GET",
        "urlPath": "/api/v1/project/lookup",
        "queryParameters": {
          "name": {
            "equalTo": "acme/empty"
          },
          "version": {
            "equalTo": "main"
          }
        },
        "headers": {
          "X-Api-Key": {
            "matches": ".+"
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "uuid": "0b6f0000-0000-4000-8000-000000000002",
          "name": "acme/empty",
          "version": "main",
          "active": true
        }
      }
    },
    {
      "name": "acme/flaky@main: DT is down",
      "priority": 1,
      "request": {
        "method": "GET",
        "urlPath": "/api/v1/project/lookup",
        "queryParameters": {
          "name": {
            "equalTo": "acme/flaky"
          }
        }
      },
      "response": {
        "status": 503,
        "body": "Service Unavailable"
      }
    },
    {
      "name": "missing API key",
      "priority": 2,
      "request": {
        "method": "ANY",
        "urlPathPattern": "/api/v1/.*",
        "headers": {
          "X-Api-Key": {
            "absent": true
          }
        }
      },
      "response": {
        "status": 401
      }
    },
    {
      "name": "any other project is unknown",
      "priority": 9,
      "request": {
        "method": "GET",
        "urlPath": "/api/v1/project/lookup"
      },
      "response": {
        "status": 404,
        "body": "The project could not be found."
      }
    },
    {
      "name": "acme/broken@main: DT answers without a uuid",
      "priority": 1,
      "request": {
        "method": "GET",
        "urlPath": "/api/v1/project/lookup",
        "queryParameters": {
          "name": {
            "equalTo": "acme/broken"
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "name": "acme/broken",
          "version": "main"
        }
      }
    },
    {
      "name": "acme/other@main is bound to another repository by tag",
      "priority": 1,
      "request": {
        "method": "GET",
        "urlPath": "/api/v1/project/lookup",
        "queryParameters": {
          "name": {
            "equalTo": "acme/other"
          },
          "version": {
            "equalTo": "main"
          }
        },
        "headers": {
          "X-Api-Key": {
            "matches": ".+"
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "uuid": "0b6f0000-0000-4000-8000-000000000003",
          "name": "acme/other",
          "version": "main",
          "active": true,
          "tags": [
            {
              "name": "team-billing"
            },
            {
              "name": "reach-repo=github.com/acme/billing"
            }
          ]
        }
      }
    }
  ]
